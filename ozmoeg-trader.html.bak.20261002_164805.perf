<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/><meta content="no-cache, no-store, must-revalidate" http-equiv="Cache-Control"/><meta content="no-cache" http-equiv="Pragma"/><meta content="0" http-equiv="Expires"/><title>OzMoEg Trader — Live Small-Cap Monitor</title><meta content="OzMoEg Money Maker — Live small-cap trading monitor with US and AUS market views, news, candidates, and trade plans." name="description"/><link href="images/logo.png" rel="icon" type="image/png"/><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/><link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;600&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/><script async="" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><style>:root{--bg-dark:#0a0e1a;--bg-panel:#111827;--bg-card:#1f2937;--border:#374151;--text-primary:#f3f4f6;--text-secondary:#9ca3af;--accent-green:#00e676;--accent-red:#ff5252;--accent-blue:#00b0ff;--accent-teal:#14b8a6;--accent-amber:#ffb300}*{margin:0;padding:0;box-sizing:border-box}html{font-size:16px}body{font-family:'Inter',sans-serif;background:var(--bg-dark);color:var(--text-primary);min-height:100vh;overflow-x:hidden}.header{background:var(--bg-panel);border-bottom:2px solid var(--accent-teal);padding:1rem 2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}.header-brand{display:flex;align-items:center;gap:1rem}.header-logo{width:48px;height:48px;background:linear-gradient(135deg,var(--accent-teal),var(--accent-blue));border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.4rem;color:white}.header-title{font-size:1.5rem;font-weight:700;background:linear-gradient(90deg,var(--accent-teal),var(--accent-green));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.header-subtitle{font-size:0.85rem;color:var(--text-secondary);margin-top:0.2rem}.header-status{display:flex;align-items:center;gap:1.5rem}.back-btn{display:inline-flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;color:var(--text-secondary);text-decoration:none;font-size:0.85rem;font-weight:500;transition:all 0.2s ease;cursor:pointer}.back-btn:hover{background:var(--accent-teal);color:#000;border-color:var(--accent-teal);text-decoration:none}.status-badge{display:flex;align-items:center;gap:0.5rem;background:rgba(0,230,118,0.15);border:1px solid var(--accent-green);padding:0.4rem 1rem;border-radius:20px;font-size:0.8rem;font-weight:500;color:var(--accent-green)}.status-dot{width:8px;height:8px;background:var(--accent-green);border-radius:50%;animation:pulse 2s infinite}@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(1.2)}}.last-updated{color:var(--text-secondary);font-size:0.8rem}.refresh-btn{background:var(--accent-teal);color:white;border:none;padding:0.5rem 1.2rem;border-radius:6px;cursor:pointer;font-weight:600;font-size:0.85rem;transition:all 0.3s}.refresh-btn:hover{background:var(--accent-blue);transform:translateY(-1px)}.last-updated.active-refresh{color:var(--accent-red);font-weight:700;animation:activeRefreshPulse 1.5s ease-in-out infinite}@keyframes activeRefreshPulse{0%,100%{text-shadow:0 0 0 transparent}50%{text-shadow:0 0 8px var(--accent-red),0 0 16px rgba(255,82,82,0.5)}}.market-toggle{display:inline-flex;align-items:center;background:var(--bg-card);border:1px solid var(--border);border-radius:999px;padding:3px;gap:3px;cursor:pointer}.market-toggle button{background:transparent;border:none;border-radius:999px;padding:0.35rem 0.9rem;color:var(--text-secondary);font-size:0.8rem;font-weight:600;cursor:pointer;transition:all 0.2s}.market-toggle button.active{background:var(--accent-teal);color:#000}.market-toggle button:hover:not(.active){color:var(--text-primary)}.sound-toggle{display:inline-flex;align-items:center;gap:0.3rem;background:var(--bg-card);border:1px solid var(--border);border-radius:999px;padding:0.35rem 0.9rem;color:var(--text-secondary);font-size:0.8rem;font-weight:600;cursor:pointer;transition:all 0.2s}.sound-toggle:hover{color:var(--text-primary);border-color:var(--accent-teal)}.sound-toggle.active{background:var(--accent-teal);color:#000;border-color:var(--accent-teal)}@keyframes flashNewAlert{0%{background-color:rgba(239,68,68,0.35)}20%{background-color:rgba(239,68,68,0.55)}100%{background-color:transparent}}.flash-new-alert{animation:flashNewAlert 5s ease-out forwards}.main-grid{display:grid;grid-template-columns:380px 1fr;gap:1rem;padding:1rem;max-width:1600px;margin:0 auto}@media (max-width:1200px){html{font-size:15px}.main-grid{grid-template-columns:1fr;padding:0.75rem;gap:0.75rem}.alert-selector{max-width:100%;flex:1 1 100%;margin-top:0.3rem}.plan-title{gap:0.5rem}.header{padding:0.8rem 1rem;gap:0.5rem;width:100%;max-width:none;flex-direction:column;align-items:stretch}.header-brand{width:100%;justify-content:flex-start}.header-title{font-size:1.2rem}.header-subtitle{font-size:0.7rem}.header-status{font-size:0.7rem;padding:0.3rem 0;width:100%;justify-content:space-between;flex-wrap:wrap;gap:0.5rem}.telegram-banner,.telegram-cta{width:100%;max-width:none;padding:0.8rem 1rem;gap:0.6rem;margin-left:0;margin-right:0}.telegram-text .title{font-size:0.9rem}.telegram-text .desc{font-size:0.75rem}.datetime-card,.countdown-card,.candidates-card,.trade-plan-card,.performance-card,.news-catalyst-card{padding:1rem;border-radius:10px}.countdown-card .countdown-timer{font-size:1.4rem;letter-spacing:1px}.countdown-card .countdown-next{font-size:0.7rem}.news-ticker-box{min-height:320px}.news-ticker-header{padding:0.6rem 0.8rem}.news-ticker-body{padding:0 0.8rem}.news-item{font-size:0.85rem;line-height:1.7}.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}#scanner-table{min-width:0;width:100%}#scanner-table th,#scanner-table td{padding:0.4rem 0.5rem;white-space:nowrap;font-size:0.75rem}#scanner-table td:nth-child(2){white-space:normal;max-width:130px}#scanner-table td:last-child{white-space:normal;max-width:130px}.trade-plan-card .plan-grid,.plan-grid{grid-template-columns:1fr !important;gap:0.5rem !important}.plan-stat .label{font-size:0.7rem}.plan-stat .value{font-size:1.1rem}.performance-card .perf-grid,.perf-grid{grid-template-columns:1fr !important;gap:0.5rem !important}.perf-box{padding:0.8rem}.perf-box .value{font-size:1.1rem}.scanned-details summary{font-size:0.85rem;padding:0.7rem 0.8rem}.scanned-table{font-size:0.7rem}.scanned-table th,.scanned-table td{padding:0.35rem 0.4rem}.news-header{flex-direction:column;align-items:flex-start;gap:0.5rem}.impact-badge{font-size:0.75rem;padding:0.3rem 0.6rem;white-space:nowrap}.result-alert,.impact-mini{white-space:nowrap;flex-shrink:0}#scanner-table td:nth-child(3){white-space:nowrap;min-width:fit-content}.catalyst-title{font-size:1rem}.catalyst-list{font-size:0.85rem}.back-btn{padding:0.6rem 1rem;font-size:0.9rem}.footer{padding:1.5rem 1rem;font-size:0.75rem}.expired-banner{padding:0.5rem;font-size:0.7rem}}@media (max-width:480px){html{font-size:14px}.header-title{font-size:1.05rem}.header-subtitle{font-size:0.65rem}.telegram-banner,.telegram-cta{padding:0.6rem 0.8rem;width:100%;max-width:none;margin-left:0;margin-right:0}.telegram-icon{font-size:1.2rem}.telegram-text .title{font-size:0.8rem}.telegram-text .desc{font-size:0.7rem}.main-grid{padding:0.5rem;gap:0.5rem}.datetime-card,.countdown-card,.candidates-card,.trade-plan-card,.performance-card,.news-catalyst-card{padding:0.8rem;border-radius:8px}.countdown-card .countdown-timer{font-size:1.2rem;letter-spacing:0.5px}.news-ticker-box{min-height:280px}.card-header h2{font-size:1rem}.scanner-badge{font-size:0.7rem}th,td{padding:0.5rem 0.6rem;font-size:0.8rem}.ticker-badge{font-size:0.65rem;padding:0.2rem 0.5rem}.news-ticker-line{font-size:0.8rem}}.datetime-card{background:var(--bg-panel);border:1px solid var(--border);border-radius:12px;padding:1.2rem}.datetime-card .label{font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--accent-teal);margin-bottom:0.5rem;font-weight:600}.datetime-card .value{font-family:'Roboto Mono',monospace;font-size:0.9rem;color:var(--text-primary);line-height:1.6}.datetime-card .timezone{color:var(--accent-amber);font-weight:600}.countdown-card{background:var(--bg-panel);border:1px solid var(--border);border-radius:12px;padding:1.2rem;text-align:center}.countdown-card .countdown-label{font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--accent-teal);margin-bottom:0.3rem;font-weight:600}.countdown-card .countdown-status{font-size:0.85rem;color:var(--text-secondary);margin-bottom:0.5rem}.countdown-card .countdown-timer{font-family:'Roboto Mono',monospace;font-size:1.8rem;font-weight:700;color:var(--accent-green);letter-spacing:2px;margin:0.5rem 0}.countdown-card .countdown-timer.open{color:var(--accent-green);animation:pulse 2s infinite}.countdown-card .countdown-timer.closed{color:var(--text-secondary)}@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.6}}.countdown-card .countdown-next{font-size:0.75rem;color:var(--text-muted);margin-top:0.3rem}.market-timeline{margin-top:0.8rem;width:100%}.market-timeline-track{display:flex;height:5px;border-radius:3px;overflow:hidden;background:var(--bg-card);position:relative}.market-timeline-segment{flex:1;min-width:0;transition:opacity 0.3s}.market-timeline-segment.pre{background:#7c4dff}.market-timeline-segment.open{background:var(--accent-green)}.market-timeline-segment.post{background:#ffab00}.market-timeline-segment.closed{background:#546e7a}.market-timeline-notch{position:absolute;top:-5px;width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:8px solid var(--text-primary);transform:translateX(-50%);transition:left 0.5s ease;filter:drop-shadow(0 0 2px rgba(0,0,0,0.5))}.market-timeline-labels{display:flex;justify-content:space-between;font-size:0.6rem;color:var(--text-secondary);margin-top:0.35rem;text-transform:uppercase;letter-spacing:0.5px}.market-timeline-labels span{flex:1;text-align:center}.market-timeline-labels span.active{color:var(--text-primary);font-weight:600}.news-title{color:var(--text-primary)}.news-ticker-box{background:#000000;border:2px solid var(--accent-green);border-radius:12px;overflow:hidden;flex:1;min-height:500px;display:flex;flex-direction:column}.news-ticker-header{background:rgba(0,230,118,0.1);border-bottom:1px solid var(--accent-green);padding:0.8rem 1rem;display:flex;justify-content:space-between;align-items:center}.news-ticker-header h3{font-size:0.9rem;color:var(--accent-green);font-weight:600;display:flex;align-items:center;gap:0.5rem}.news-scroll-icon{animation:scroll-bounce 1.5s infinite}@keyframes scroll-bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}.news-ticker-body{flex:1;overflow:hidden;position:relative;padding:0 1rem}.news-ticker-scroll{animation:ticker-scroll 40s linear infinite}.news-ticker-scroll:hover{animation-play-state:paused}@keyframes ticker-scroll{0%{transform:translateY(0)}100%{transform:translateY(-50%)}}.news-item{font-family:'Roboto Mono',monospace;font-size:0.8rem;color:var(--accent-green);line-height:1.8;padding:0.6rem 0;border-bottom:1px dashed rgba(0,230,118,0.2)}.news-item .time{color:var(--accent-amber);font-size:0.75rem}.news-item .date{color:var(--text-muted);font-size:0.7rem;margin-right:0.3rem}.news-item .score{display:inline-block;background:rgba(0,230,118,0.2);padding:0.1rem 0.4rem;border-radius:4px;font-size:0.7rem;margin-right:0.4rem}.news-item .news-age{display:inline-block;padding:0.1rem 0.4rem;border-radius:4px;font-size:0.7rem;font-weight:600;margin-right:0.4rem;background:rgba(0,212,255,0.10);border:1px solid rgba(0,212,255,0.35);color:var(--accent-cyan)}.news-item .news-age.stale{background:rgba(255,76,76,0.12);border-color:rgba(255,76,76,0.40);color:var(--accent-red)}.news-item.candidate{color:var(--accent-blue);font-weight:600}.news-item.candidate .score{background:rgba(0,176,255,0.2);color:var(--accent-blue)}.news-item.skip{color:var(--text-secondary);font-size:0.75rem}.right-panel{display:flex;flex-direction:column;gap:1rem}.pre-market-card{background:var(--bg-panel);border:1px solid var(--accent-amber);border-radius:12px;padding:1rem 1.5rem;margin-top:0.5rem}.pre-market-card h3{margin:0 0 0.75rem 0;font-size:1rem}.pre-market-table th{background:rgba(255,179,0,0.1);color:var(--accent-amber)}.candidates-card{background:var(--bg-panel);border:1px solid var(--border);border-radius:12px;overflow:hidden}.card-header{padding:1rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}.card-header h2{font-size:1.1rem;font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:0.5rem}.card-header .badge{background:var(--accent-teal);color:white;padding:0.2rem 0.7rem;border-radius:12px;font-size:0.75rem;font-weight:600}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:0.9rem}th{background:rgba(20,184,166,0.1);color:var(--accent-teal);font-weight:600;text-align:left;padding:0.8rem 1rem;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.5px}td{padding:0.8rem 1rem;border-bottom:1px solid var(--border);color:var(--text-primary)}tr:last-child td{border-bottom:none}tr:hover td{background:rgba(255,255,255,0.03)}.ticker-cell{font-family:'Roboto Mono',monospace;font-weight:700;font-size:1rem}.ticker-cell .name{font-size:0.75rem;color:var(--text-secondary);font-weight:400}.result-pass{color:var(--accent-green);font-weight:600}.result-skip{color:var(--text-secondary)}.result-alert{background:rgba(0,230,118,0.15);color:var(--accent-green);padding:0.3rem 0.8rem;border-radius:6px;font-weight:600;font-size:0.8rem;display:inline-flex;align-items:center;gap:0.3rem;white-space:nowrap;flex-shrink:0}#scanner-table td:nth-child(3),#scanner-table td.status-column{white-space:nowrap;min-width:fit-content}.impact-mini{font-size:0.7rem;font-weight:700;padding:0.15rem 0.4rem;border-radius:4px;border:1px solid;margin-left:0.3rem;white-space:nowrap;display:inline-flex;align-items:center;gap:0.2rem;min-width:fit-content}.impact-mini.impact-high{color:var(--accent-red);border-color:var(--accent-red);background:rgba(255,82,82,0.08)}.impact-mini.impact-medium{color:var(--accent-amber);border-color:var(--accent-amber);background:rgba(255,171,0,0.08)}.impact-mini.impact-low{color:var(--accent-green);border-color:var(--accent-green);background:rgba(0,230,118,0.08)}.impact-mini.impact-au-limited{color:#fff;border-color:var(--accent-amber);background:rgba(255,171,0,0.25)}.tape-mini{display:inline-flex;align-items:center;gap:0.2rem;padding:0.15rem 0.4rem;border-radius:4px;border:1px solid var(--border);font-size:0.75rem;font-weight:600;white-space:nowrap}.tape-mini.tape-high{color:var(--accent-red);border-color:var(--accent-red);background:rgba(255,82,82,0.08)}.tape-mini.tape-medium{color:var(--accent-amber);border-color:var(--accent-amber);background:rgba(255,171,0,0.08)}.tape-mini.tape-low{color:var(--accent-green);border-color:var(--accent-green);background:rgba(0,230,118,0.08)}.tape-mini.tape-missing{color:var(--text-secondary);border-color:var(--border);background:transparent}.tape-legend{background:rgba(0,0,0,0.2);border:1px solid var(--border);border-radius:8px;padding:0.75rem 1rem;margin-top:0.5rem}.tape-legend p{margin:0 0 0.6rem;font-size:0.8rem;color:var(--text-secondary)}.tape-legend .tape-note{margin:0.6rem 0 0;font-size:0.75rem}.tape-bar{display:grid;grid-template-columns:9rem 1fr 4rem;align-items:center;gap:0.6rem;margin:0.35rem 0;font-size:0.78rem}.tape-bar .tape-label{color:var(--text-primary)}.tape-bar .tape-track{height:6px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden}.tape-bar .tape-fill{height:100%;background:var(--accent-amber);border-radius:3px;transition:width 0.3s ease}.tape-bar .tape-value{text-align:right;color:var(--text-secondary)}.scanned-details{margin-top:1rem;border:1px solid var(--border);border-radius:8px;background:var(--bg-card)}.scanned-details summary{padding:0.8rem 1rem;cursor:pointer;font-size:0.9rem;font-weight:600;color:var(--accent-blue);user-select:none}.scanned-details summary:hover{background:rgba(255,255,255,0.03)}.scanned-table{font-size:0.8rem}.scanned-table th{padding:0.5rem 0.6rem;font-size:0.7rem}.scanned-table td{padding:0.5rem 0.6rem;white-space:normal}.scan-pass{background:rgba(0,230,118,0.15);color:var(--accent-green);padding:0.15rem 0.4rem;border-radius:4px;font-size:0.7rem;font-weight:600}.scan-skip{background:rgba(255,255,255,0.08);color:var(--text-secondary);padding:0.15rem 0.4rem;border-radius:4px;font-size:0.7rem;font-weight:600}.trade-plan-card{background:linear-gradient(135deg,var(--card-bg),#0a0f1a);border:1px solid var(--border);border-radius:12px;padding:1.5rem}.news-catalyst-card{background:linear-gradient(135deg,var(--card-bg),#0a0f1a);border:1px solid var(--border);border-radius:12px;padding:1.5rem;margin-top:1rem}.news-catalyst-card .news-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}.news-catalyst-card .news-ticker-line{background:rgba(0,230,118,0.08);border:1px solid rgba(0,230,118,0.3);border-radius:8px;padding:0.6rem 1rem;margin-bottom:1rem;font-size:0.95rem;color:var(--text-secondary);display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap}.news-catalyst-card .news-ticker-line strong{color:var(--accent-green);font-size:1.1rem}.news-catalyst-card .news-scan-time{margin-left:auto;font-size:0.8rem;color:var(--text-secondary);font-style:italic}.news-catalyst-card .news-list a{color:var(--accent-blue);text-decoration:none;font-weight:500;transition:color 0.2s}.news-catalyst-card .news-list a:hover{color:var(--accent-cyan);text-decoration:underline}.news-catalyst-card .news-list .news-meta{display:block;font-size:0.75rem;color:var(--text-secondary);margin-top:0.2rem;margin-left:3.5rem}.news-catalyst-card .news-list li{margin-bottom:10px;line-height:1.45;color:var(--text-secondary);display:flex;flex-wrap:wrap;align-items:flex-start;gap:6px}.news-catalyst-card .news-list .news-age{display:inline-flex;align-items:center;gap:4px;font-size:0.78rem;font-weight:700;color:var(--accent-cyan);background:rgba(0,212,255,0.10);padding:2px 8px;border-radius:4px;border:1px solid rgba(0,212,255,0.30);white-space:nowrap;cursor:help;letter-spacing:0.02em}.news-catalyst-card .news-list .news-age.stale{color:var(--accent-red);background:rgba(255,76,76,0.12);border-color:rgba(255,76,76,0.40)}.news-catalyst-card .news-list .news-age .news-date-hint{font-weight:500;opacity:0.72}.news-age-cell{font-size:0.75rem;white-space:nowrap}.news-age-cell .news-age{display:inline-block;padding:0.2rem 0.5rem;border-radius:999px;background:rgba(0,212,255,0.10);border:1px solid rgba(0,212,255,0.35);color:var(--accent-cyan);font-weight:600;cursor:help}.news-age-cell .news-age.stale{background:rgba(255,76,76,0.12);border-color:rgba(255,76,76,0.40);color:var(--accent-red)}.news-age-cell .news-age.missing{background:rgba(156,163,175,0.12);border-color:var(--text-secondary);color:var(--text-secondary);font-weight:400}.news-catalyst-card .news-header h2{margin:0;font-size:1.1rem;color:var(--text-primary)}.news-catalyst-card .news-legend{margin:0.5rem 0 0.75rem;font-size:0.78rem;color:var(--text-secondary);max-width:100%;line-height:1.4;background:rgba(0,212,255,0.06);border-left:3px solid var(--accent-cyan);padding:0.45rem 0.7rem;border-radius:0 4px 4px 0}.news-catalyst-card .impact-badge{background:transparent;padding:0.25rem 0.7rem;border-radius:4px;font-size:0.8rem;font-weight:700;border:1.5px solid}.news-catalyst-card .impact-badge.impact-high{color:var(--accent-red);border-color:var(--accent-red)}.news-catalyst-card .impact-badge.impact-medium{color:va